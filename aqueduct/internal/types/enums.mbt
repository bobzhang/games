///|
pub(all) enum Direction {
  North
  East
  South
  West
} derive(Eq, Debug)

///|
pub extend Direction with Eq::{not_equal, equal}

///|
pub extend Direction with Debug::{to_repr}

///|
pub impl Show for Direction with fn output(self, logger) {
  Show::output(Debug::to_repr(self), logger)
}

///|
pub extend Direction with Show::{to_string, output}

///|
pub fn Direction::opposite(self : Direction) -> Direction {
  match self {
    North => South
    South => North
    East => West
    West => East
  }
}

///|
pub fn Direction::dx(self : Direction) -> Int {
  match self {
    East => 1
    West => -1
    _ => 0
  }
}

///|
pub fn Direction::dy(self : Direction) -> Int {
  match self {
    South => 1
    North => -1
    _ => 0
  }
}

///|
pub let all_directions : Array[Direction] = [North, East, South, West]
