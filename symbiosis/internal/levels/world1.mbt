// World 1: Mirror - Basic mirrored movement, simple walls

///|
pub fn level_1_1() -> @types.Level {
  // Simple introduction: walk right to exit
  let floor = [
    "############", "##..........#", "#@........X#", "############",
    "############", "############", "############", "############",
  ]
  let ceiling = [
    "############", "############", "#X........@#", "##..........#",
    "############", "############", "############", "############",
  ]
  make_level(0, 0, floor, ceiling, [], BothExit, 10)
}

