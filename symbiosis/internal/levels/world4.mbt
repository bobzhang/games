///|
pub fn level_4_7() -> @types.Level {
  // Ultimate challenge
  let floor = [
    "############", "#@..a..b...#", "#.A........#", "#..0..P....#", "#..III.....#",
    "#.....1..a.#", "#........bX#", "############",
  ]
  let ceiling = [
    "############", "#...b..a..@#", "#........A.#", "#....P..0..#", "#.....III..#",
    "#.a..1.....#", "#Xb........#", "############",
  ]
  make_level(
    3,
    6,
    floor,
    ceiling,
    [{ switch_id: 0, door_id: 0 }, { switch_id: 1, door_id: 1 }],
    BothExit,
    25,
  )
}
