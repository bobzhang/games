// World 4: Mastery - All mechanics, tight move counts

///|
pub fn level_4_1() -> @types.Level {
  // Switches + anchors
  let floor = [
    "############", "#@....a....#", "#..A.......#", "#..0.......#", "#..........#",
    "#.........X#", "############", "############",
  ]
  let ceiling = [
    "############", "#....a....@#", "#.......A..#", "#.......0..#", "#..........#",
    "#X.........#", "############", "############",
  ]
  make_level(3, 0, floor, ceiling, [{ switch_id: 0, door_id: 0 }], BothExit, 18)
}

